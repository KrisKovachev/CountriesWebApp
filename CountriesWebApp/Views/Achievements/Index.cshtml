@using CountriesWebApp.Core.Models.ViewModel
@model List<AchievementViewModel>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Achievements</title>

    <!-- ВАЖНО: absolute path (без ~) -->
    <link rel="stylesheet" href="/css/achievemetns.css?v=1" />
    <link rel="shortcut icon" href="/images/fav_icon.png" type="image/png" />
</head>

<body>
    <!-- FLOATING TOP BUTTONS -->
    <div class="button-row">
        <a href="/Auth/Profile" class="nav-btn">Back</a>
        <a href="/Auth/Logout" class="nav-btn">Logout</a>
    </div>

    <div class="ach-wrap">
        <h1 class="ach-title">Achievements</h1>

        <div class="ach-grid">
            @foreach (var a in Model)
            {
                <div class="ach-card @(a.Unlocked ? "ach-unlocked" : "ach-locked")">
                    <div class="ach-header">
                        <span class="ach-dot"></span>
                        <h3>@a.Title</h3>
                    </div>

                    <p class="ach-desc">@a.Description</p>

                    <div class="ach-footer">
                        <span class="ach-points">@a.Points pts</span>

                        @if (a.Unlocked)
                        {
                            <span class="ach-status good">Unlocked</span>
                        }
                        else
                        {
                            <span class="ach-status bad">Locked</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</body>
</html>
