@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register</title>

    <link rel="shortcut icon" href="~/images/fav_icon.png" type="image/png" />

    <style>
        @@import url('https://fonts.googleapis.com/css?family=Fjalla+One&display=swap');
        /* RESET */
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            font-family: 'Fjalla One', sans-serif;
        }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(1000px at 15% 20%, rgba(0,200,255,0.25), transparent 60%), radial-gradient(1000px at 85% 80%, rgba(140,90,255,0.30), transparent 65%), linear-gradient(135deg, #050814, #140a2b);
            color: #fff;
        }

        /* LOGIN FORM (NO CARD, NO COLUMN) */
        form {
            width: 360px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            text-align: center;
            animation: fadeUp 0.6s ease-out;
        }

        h2 {
            margin: 0 0 12px;
            font-size: 34px;
            letter-spacing: 0.5px;
            background: linear-gradient(90deg, #00eaff, #8a7cff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        input {
            width: 100%;
            padding: 14px 18px;
            font-size: 15pt;
            border-radius: 18px;
            border: none;
            outline: none;
            background: rgba(255,255,255,0.08);
            color: #fff;
            box-shadow: inset 0 0 0 1px rgba(255,255,255,0.2);
            transition: 0.25s ease;
        }

            input::placeholder {
                color: #aab2d6;
            }

            input:focus {
                background: rgba(255,255,255,0.12);
                box-shadow: inset 0 0 0 1px #00eaff, 0 0 18px rgba(0,200,255,0.6);
            }

        button {
            margin-top: 10px;
            padding: 14px;
            font-size: 16pt;
            font-weight: bold;
            border-radius: 22px;
            border: none;
            cursor: pointer;
            color: #fff;
            background: linear-gradient(135deg, #00d0ff, #6b5cff);
            transition: 0.25s ease;
        }

            button:hover {
                transform: translateY(-2px);
                box-shadow: 0 14px 32px rgba(0,180,255,0.6);
            }

        .links {
            margin-top: 20px;
            font-size: 13pt;
            color: #c7ccff;
        }

            .links a {
                color: #7fdcff;
                text-decoration: none;
                border-bottom: 1px solid transparent;
            }

                .links a:hover {
                    border-bottom-color: #7fdcff;
                }

        .validation-summary-errors {
            color: #ff6b6b;
            font-size: 13pt;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(30px) scale(0.96);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
    </style>
</head>

<body>

    <form class="auth-box" method="post" asp-action="Register">

        <h2>Create Account</h2>

        <input class="auth-input"
               type="text"
               name="username"
               placeholder="Username"
               required />

        <input class="auth-input"
               type="email"
               name="email"
               placeholder="Email"
               required />

        <input class="auth-input"
               type="password"
               name="password"
               placeholder="Password"
               required />

        <button class="auth-btn" type="submit">
            Register
        </button>

        @if (ViewBag.Error != null)
        {
            <div class="auth-error">@ViewBag.Error</div>
        }

        <div class="links">
            Already have an account?
            <a asp-action="Login" asp-controller="Auth">Sign in</a>
        </div>

    </form>

</body>
</html>
