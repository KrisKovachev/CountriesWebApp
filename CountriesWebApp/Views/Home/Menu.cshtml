@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Choose Region</title>

    <link rel="shortcut icon" href="/images/fav_icon.png" type="image/png" />
    <link rel="stylesheet" href="/css/choose-region.css?v=1" />
</head>

<body>

    <!-- FLOATING BUTTONS -->
    <div class="button-row">
        <a href="/Home/Index" class="nav-btn">Back</a>
        <a href="/Auth/Profile" class="nav-btn">Profile</a>
    </div>

    <div class="region-container">
        <h1>Choose Region</h1>

        <div class="region-list">
            <button class="region-btn" data-region="all">All Countries</button>
            <button class="region-btn" data-region="Europe">Europe</button>
            <button class="region-btn" data-region="Asia">Asia</button>
            <button class="region-btn" data-region="Africa">Africa</button>
            <button class="region-btn" data-region="Americas">Americas</button>
            <button class="region-btn" data-region="Oceania">Oceania</button>
        </div>
    </div>

    <script>
        document.querySelectorAll('.region-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                localStorage.setItem('region', btn.dataset.region);
                window.location.href = '/Home/Quiz';
            });
        });
    </script>

</body>
</html>
