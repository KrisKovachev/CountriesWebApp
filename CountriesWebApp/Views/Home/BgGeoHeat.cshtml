@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>BG GeoHeat</title>

    <link rel="shortcut icon" href="/images/fav_icon.png" type="image/png" />
    <link rel="stylesheet" href="/css/bggeoheat.css?v=2" />
</head>

<body>

    <!-- NAVBAR -->
    <nav class="top-nav">
        <div class="nav-left">
            <span class="nav-brand">Country Quiz</span>
            <a href="/Home/Index">Home</a>
            <a href="/Home/GameMode">Modes</a>
        </div>

        <div class="nav-right">
            <a href="/Auth/Profile">Profile</a>
            <a href="/Auth/Logout">Logout</a>
        </div>
    </nav>

    <main class="bggeo-page">

        <div class="bggeo-sidebar">
            <h1>🇧🇬 BG GeoHeat Guess</h1>

            <p class="subtitle">
                Намери тайната област. Цветът показва колко си близо.
            </p>

            <div class="stats">
                <div><span>Разстояние:</span> <span id="distValue">—</span></div>
                <div><span>Опити:</span> <span id="triesValue">0</span></div>
            </div>

            <p class="hint">
                Кликни върху област на картата.
                Зелен = много близо • Червен = много далеч.
            </p>
        </div>

        <div class="bggeo-main">
            <h2>Карта на областите</h2>

            <div class="map-wrapper">
                @Html.Raw(System.IO.File.ReadAllText("wwwroot/images/bg-regions.svg"))
                <div id="heatTooltip" class="heat-tooltip" style="display:none;"></div>
            </div>

            <!-- Victory Modal -->
            <div id="victoryModal" class="modal-overlay" style="display:none;">
                <div class="modal-box">
                    <h1 class="modal-title">🎉 Победа!</h1>
                    <p class="modal-body">
                        Позна тайната област:<br>
                        <span id="victoryRegion" class="modal-region"></span>
                    </p>
                    <div class="modal-buttons">
                        <button id="newGameBtn" class="modal-btn modal-primary">
                            Нова игра
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <!-- GAME LOGIC (НЕ ПИПАМЕ) -->
    <script src="/js/bggeoheat.js"></script>

</body>
</html>
