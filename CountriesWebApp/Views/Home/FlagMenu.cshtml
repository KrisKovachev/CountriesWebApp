@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Select Region</title>

    <link rel="shortcut icon" href="/images/fav_icon.png" type="image/png" />
    <!-- ВАЖНО: ползваме съществуващия CSS -->
    <link rel="stylesheet" href="/css/choose-region.css?v=2" />
</head>

<body>

    <!-- FLOATING BUTTONS (същите като другото меню) -->
    <div class="button-row">
        <a href="/Home/GameMode" class="nav-btn">Back</a>
        <a href="/Home/Index" class="nav-btn">Home</a>
    </div>

    <!-- MAIN -->
    <div class="region-container">
        <h1>Select Region</h1>

        <div class="region-list">
            <button class="region-btn" data-region="all">
                All Countries
            </button>

            <button class="region-btn" data-region="Europe">
                Europe
            </button>

            <button class="region-btn" data-region="Asia">
                Asia
            </button>

            <button class="region-btn" data-region="Africa">
                Africa
            </button>

            <button class="region-btn" data-region="Americas">
                Americas
            </button>

            <button class="region-btn" data-region="Oceania">
                Oceania
            </button>
        </div>
    </div>

    <script>
        // REGION LOGIC – само това остава
        document.querySelectorAll('.region-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const region = btn.dataset.region;
                localStorage.setItem('region', region);
                window.location.href = '/Home/FlagQuiz';
            });
        });
    </script>

</body>
</html>
