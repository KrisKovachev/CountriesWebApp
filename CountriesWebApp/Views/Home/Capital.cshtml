@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Guess the Capital</title>

    <link rel="shortcut icon" href="/images/fav_icon.png" type="image/png" />
    <link rel="stylesheet" href="/css/capital.css?v=2" />

    <script src="https://cdn.jsdelivr.net/npm/js-confetti@latest/dist/js-confetti.browser.js"></script>
</head>

<body>

    <!-- NAVBAR (самостоятелен, без Layout) -->
    <nav class="top-nav">
        <div class="nav-left">
            <span class="nav-brand">Country Quiz</span>
            <a href="/Home/Index">Home</a>
            <a href="/Home/GameMode">Modes</a>
        </div>
        <div class="nav-right">
            <a href="/Auth/Profile">Profile</a>
            <a href="/Auth/Logout">Logout</a>
        </div>
    </nav>

    <!-- MAIN GAME -->
    <div class="container">

        <audio id="bgMusic" src="/sound/game.mp3" autoplay loop></audio>

        <h1>Guess the Country by Capital!</h1>

        <div id="countryBox">
            <p>Which country has this capital?</p>
            <h2 id="capitalName">Loading...</h2>
        </div>

        <div id="timer">⏱️ Time: 15s</div>

        <div class="options" id="options">
            <button class="option-btn" data-index="0">A)</button>
            <button class="option-btn" data-index="1">B)</button>
            <button class="option-btn" data-index="2">C)</button>
            <button class="option-btn" data-index="3">D)</button>
        </div>

        <div>
            <button id="nextBtn">Next</button>
        </div>

        <div id="message"></div>
        <div id="score">Score: 0</div>
        <div id="leaderboard"></div>
    </div>

    <!-- GAME LOGIC (НЕ ПИПАМЕ) -->
    <script src="/js/capital.js"></script>

    <script>
        const bgMusic = document.getElementById('bgMusic');
        bgMusic.volume = 0.5;
        bgMusic.play().catch(() =>
            document.body.addEventListener('click', () => bgMusic.play(), { once: true })
        );
    </script>

</body>
</html>
